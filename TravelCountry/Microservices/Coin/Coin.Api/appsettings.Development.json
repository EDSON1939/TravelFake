{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Grpc": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\YastaCoin\\Coin\\logs\\dev-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "",
    "ServiceName": "coin-service-dev"
  },

  "Database": {
    "ConnectionString": "Server=localhost;Database=DB_YastaCoin_Dev;User Id=sa;Password=CONTRASENA_LOCAL;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  }
}
