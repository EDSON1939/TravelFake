{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\TravelFake\\Country\\logs\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://192.168.1.100:3100",
          "textFormatter": "Core.AuditTrail.LokiTextFormatter, Core.AuditTrail",
          "labels": [
            { "key": "app",         "value": "country-service" },
            { "key": "environment", "value": "production"      }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "OpenTelemetry": {
    "Enabled": true,
    "Endpoint": "http://192.168.1.100:4317",
    "ServiceName": "country-service"
  },

  "Database": {
    "ConnectionString": "Server=localhost;Database=TRAVELFAKE;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "Jwt": {
    "TokenSecret": "REEMPLAZAR_CON_SECRET_DE_32_CARACTERES_MINIMO",
    "TokenLifetime": 5
  },

  "Authorization": []
}
