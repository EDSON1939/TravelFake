    </mxCell>

    <mxCell id="map" value="AccountCreation.ToResponse traduce el codigo del SP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0EE;strokeColor=#6A7975;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="290" y="890" width="360" height="40" as="geometry" />
    </mxCell>

    <mxCell id="ok" value="id &gt; 0&#10;SUC000 + id de la cuenta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1F0E6;strokeColor=#1D6B3B;fontSize=11;fontStyle=1;" vertex="1" parent="1">
