<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="pipeline-grpc" name="Pipeline gRPC">
<mxGraphModel dx="1100" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1250" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="tit" value="Pipeline de una llamada gRPC — AccountsAndMovements" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1F3A34;" vertex="1" parent="1">
      <mxGeometry x="60" y="20" width="980" height="30" as="geometry" />
    </mxCell>
    <mxCell id="sub" value="Los interceptores corren en el orden en que se registran en Program.cs: el primero es el mas externo" style="text;html=1;fontSize=12;align=center;fontColor=#3D4A47;" vertex="1" parent="1">
      <mxGeometry x="60" y="52" width="980" height="20" as="geometry" />
    </mxCell>

    <mxCell id="n0" value="Llamada gRPC&#10;Authorization: Bearer ..." style="ellipse;whiteSpace=wrap;html=1;fillColor=#DFEEEA;strokeColor=#0C5C52;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="380" y="90" width="240" height="50" as="geometry" />
    </mxCell>

    <mxCell id="i1" value="1 · ValidationInterceptor&#10;busca un IValidator del mensaje Pb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0EE;strokeColor=#6A7975;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="170" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="i2" value="2 · LoggerInterceptor&#10;cronometra y registra en Serilog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEEA;strokeColor=#0C5C52;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="255" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="i3" value="3 · JwtAuthorizationInterceptor&#10;exige el header; NO valida la firma" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7EEDA;strokeColor=#835710;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="340" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="i4" value="4 · AuditInterceptor&#10;deja la fila en aud.BITACORA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEEA;strokeColor=#0C5C52;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="425" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="svc" value="AccountsAndMovementsService&#10;traduce el mensaje Pb a un comando o consulta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D4A47;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="510" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="med" value="MediatR — ValidationBehavior&#10;aca SI corren las reglas de FluentValidation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D4A47;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="595" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="hdl" value="Handler&#10;valida contra los servicios externos y decide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D4A47;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="340" y="680" width="320" height="55" as="geometry" />
    </mxCell>

    <mxCell id="rep" value="Repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3D4A47;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="380" y="765" width="240" height="40" as="geometry" />
    </mxCell>

    <mxCell id="dap" value="IQuery — Dapper&#10;SQL explicito, solo lectura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0EE;strokeColor=#6A7975;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="200" y="845" width="240" height="55" as="geometry" />
    </mxCell>

    <mxCell id="sp" value="ICommand — stored procedure&#10;toda escritura, en una transaccion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEEA;strokeColor=#0C5C52;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="560" y="845" width="240" height="55" as="geometry" />
    </mxCell>

    <mxCell id="db" value="SQL Server — DB_QRBolivia&#10;commerce.CUENTA · commerce.MOVIMIENTO&#10;aud.BITACORA · aud.AUDITORIA" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#EAF0EE;strokeColor=#0C5C52;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="940" width="300" height="105" as="geometry" />
    </mxCell>

    <mxCell id="r1" value="Hoy no corta nada: los validadores son de los&#10;comandos de MediatR, no de los mensajes Pb,&#10;asi que no encuentra ninguno y deja pasar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0EE;strokeColor=#6A7975;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="730" y="170" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="r2" value="Excepcion no controlada&#10;→ ERR001, sin tumbar el proceso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E8E2;strokeColor=#9B3C23;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="730" y="255" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="r3" value="Sin Bearer → Unauthenticated&#10;[AllowAnonymous] en el metodo lo saltea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E8E2;strokeColor=#9B3C23;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="730" y="340" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="r4" value="Escribe la fila termine como termine, OK o ERROR.&#10;Si la escritura falla: warning y la respuesta sigue.&#10;Auditar no puede tumbar la operacion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0E6;strokeColor=#1D6B3B;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="730" y="425" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="r5" value="Reglas del comando incumplidas → VAL001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E8E2;strokeColor=#9B3C23;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="730" y="595" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="r6" value="Reglas de negocio → CUSTOMER_NOT_FOUND,&#10;QR_EXPIRED, INSUFFICIENT_FUNDS, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E8E2;strokeColor=#9B3C23;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="730" y="680" width="310" height="55" as="geometry" />
    </mxCell>

    <mxCell id="nota" value="El auditor es el interceptor 4: lo que corta el JWT en el 3 nunca llega a el, asi que una llamada sin token no deja fila en aud.BITACORA" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#835710;fontSize=11;fontColor=#835710;" vertex="1" parent="1">
      <mxGeometry x="200" y="1080" width="840" height="45" as="geometry" />
    </mxCell>

