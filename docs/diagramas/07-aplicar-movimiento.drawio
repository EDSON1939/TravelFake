      <mxGeometry x="140" y="250" width="880" height="800" as="geometry" />
    </mxCell>

    <mxCell id="s1" value="BEGIN TRAN&#10;SELECT commerce.CUENTA WITH (UPDLOCK, HOLDLOCK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEEA;strokeColor=#0C5C52;fontSize=10;fontStyle=1;" vertex="1" parent="1">
