    <mxCell id="d2" value="¿Ya hay un asiento con esa&#10;clave de idempotencia?&#10;(la clave es unica en todo el sistema:&#10;se busca sin filtrar por cuenta)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F7EEDA;strokeColor=#835710;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="300" y="450" width="320" height="90" as="geometry" />
