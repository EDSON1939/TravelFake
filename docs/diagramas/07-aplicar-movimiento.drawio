      <mxGeometry x="680" y="450" width="320" height="90" as="geometry" />
    </mxCell>

    <mxCell id="k1" value="Reintento&#10;devuelve el id del&#10;asiento original&#10;NO aplica nada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0E6;strokeColor=#1D6B3B;fontSize=10;" vertex="1" parent="1">
