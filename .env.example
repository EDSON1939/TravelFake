# =============================================================================
# Copiar a .env y cambiar los valores. El .gitignore ya excluye *.env, asi que
# el .env real nunca se sube: el reto pide explicitamente no dejar secretos en
# el codigo fuente.
#
#   cp .env.example .env
# =============================================================================

# Contrasena del usuario sa de SQL Server. La imagen la rechaza si no tiene al
# menos 8 caracteres con mayusculas, minusculas, numeros y simbolos.
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_123!

# Secreto de firma de los JWT que emite Auth. Minimo 32 caracteres: el generador
# lo valida al arrancar y falla si es mas corto.
JWT_TOKEN_SECRET=cambiar-este-secreto-de-al-menos-32-caracteres
