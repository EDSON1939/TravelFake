{
  // Configuracion para el contenedor. Ver el equivalente de AccountsAndMovements:
  // mismo motivo, rutas de log de Windows y un sink de Loki que dentro del
  // contenedor no responde.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      // Neutraliza el sink de Loki heredado de appsettings.json: los arreglos
      // se fusionan por indice y no se pueden acortar.
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Fatal"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "",
    "ServiceName": "auth-service"
  },

  // Jwt:TokenSecret y la cadena de conexion llegan por variable de entorno
  // desde docker-compose.yml. Nunca en un archivo del repositorio.
  "Jwt": {
    "TokenLifetime": 30,
    "MaxFailedAttempts": 5,
    "LockMinutes": 15
  },

  "Services": {
    "Client": { "BaseAddress": "http://clients:8080" }
  }
}
