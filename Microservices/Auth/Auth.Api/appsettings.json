{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\YastaCoin\\Auth\\logs\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://192.168.1.100:3100",
          "textFormatter": "Core.AuditTrail.LokiTextFormatter, Core.AuditTrail",
          "labels": [
            { "key": "app",         "value": "auth-service"  },
            { "key": "environment", "value": "production"    }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "OpenTelemetry": {
    "Enabled": true,
    "Endpoint": "http://192.168.1.100:4317",
    "ServiceName": "auth-service"
  },

  "Database": {
    "ConnectionString": "Server=10.73.72.22,1433;Database=DB_YastaCoinE;User Id=yasta_dev;Password=YastaDev2026!;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "Services": {
    "Client": {
      "BaseAddress": "https://localhost:52118",
      "PolicyConfiguration": {
        "RetryCount": 3,
        "InitialBackoff": 1,
        "MaxBackoff": 5,
        "BackoffMultiplier": 2
      }
    }
  },

  "Jwt": {
    "TokenSecret": "REEMPLAZAR_CON_SECRET_DE_32_CARACTERES_MINIMO",
    "TokenLifetime": 5,
    "MaxFailedAttempts": 5,
    "LockMinutes": 15
  }
}
