{
  // Configuracion para el contenedor. Se activa con ASPNETCORE_ENVIRONMENT=Docker,
  // que es lo que pone docker-compose.yml.
  //
  // Existe por dos motivos concretos: las rutas de log de appsettings.json son
  // de Windows y no valen en Linux, y el sink de Grafana Loki apunta a una IP de
  // la red de la oficina que dentro del contenedor no responde.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      // La configuracion de .NET fusiona los arreglos por indice, asi que no se
      // puede "acortar" WriteTo: si no se declara un tercer elemento, sobrevive
      // el de Grafana Loki de appsettings.json y el contenedor se pasa
      // reintentando una conexion que no existe. Este lo neutraliza sin
      // duplicar la salida: solo dejaria pasar un Fatal.
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Fatal"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "",
    "ServiceName": "accounts-movements-service"
  },

  // La cadena de conexion, la bandera de los catalogos en memoria y DevAuth los
  // inyecta docker-compose.yml como variables de entorno: dependen del entorno,
  // no del servicio.
  //
  // Las direcciones de abajo asumen que el destino es otro contenedor de este
  // compose. Comercios todavia no lo es: corre fuera, asi que su BaseAddress y
  // su UseFake se pisan desde docker-compose.yml, que es quien sabe en que host
  // esta. Ver Services__Commerce__* ahi.
  "Services": {
    "Client":   { "BaseAddress": "http://clients:8080" },
    "Commerce": { "BaseAddress": "http://commerces:8080" },
    "Qr":       { "BaseAddress": "http://qr:8080" },
    "Currency": { "BaseAddress": "http://currencies:8080" }
  }
}
