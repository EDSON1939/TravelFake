{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\QRBolivia\\AccountsAndMovements\\logs\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://192.168.1.100:3100",
          "textFormatter": "Core.AuditTrail.LokiTextFormatter, Core.AuditTrail",
          "labels": [
            { "key": "app",         "value": "accounts-movements-service" },
            { "key": "environment", "value": "production"                 }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "OpenTelemetry": {
    "Enabled": true,
    "Endpoint": "http://192.168.1.100:4317",
    "ServiceName": "accounts-movements-service"
  },

  "Database": {
    "ConnectionString": "Server=10.73.72.22,1433;Database=DB_QRBolivia;User Id=yasta_dev;Password=YastaDev2026!;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "Services": {
    "Client": {
      "BaseAddress": "https://localhost:52140",
      "PolicyConfiguration": {
        "RetryCount": 3,
        "InitialBackoff": 1,
        "MaxBackoff": 5,
        "BackoffMultiplier": 2
      },
      "CircuitBreaker": {
        "MinimumThroughput": 4,
        "SamplingSeconds": 30,
        "BreakSeconds": 15
      }
    },
    "Commerce": {
      "BaseAddress": "https://10.73.72.110:59537",
      "PolicyConfiguration": {
        "RetryCount": 3,
        "InitialBackoff": 1,
        "MaxBackoff": 5,
        "BackoffMultiplier": 2
      },
      "CircuitBreaker": {
        "MinimumThroughput": 4,
        "SamplingSeconds": 30,
        "BreakSeconds": 15
      }
    },
    "Qr": {
      "BaseAddress": "https://10.73.72.110:52118",
      "PolicyConfiguration": {
        "RetryCount": 3,
        "InitialBackoff": 1,
        "MaxBackoff": 5,
        "BackoffMultiplier": 2
      },
      "CircuitBreaker": {
        "MinimumThroughput": 4,
        "SamplingSeconds": 30,
        "BreakSeconds": 15
      }
    },
    "Currency": {
      "BaseAddress": "https://localhost:52146",
      "PolicyConfiguration": {
        "RetryCount": 3,
        "InitialBackoff": 1,
        "MaxBackoff": 5,
        "BackoffMultiplier": 2
      },
      "CircuitBreaker": {
        "MinimumThroughput": 4,
        "SamplingSeconds": 30,
        "BreakSeconds": 15
      }
    }
  }
}
