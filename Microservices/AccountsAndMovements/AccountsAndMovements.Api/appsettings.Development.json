{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Grpc": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\QRBolivia\\AccountsAndMovements\\logs\\dev-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "",
    "ServiceName": "accounts-movements-service-dev"
  },

  "Database": {
    "ConnectionString": "Server=10.73.72.22,1433;Database=DB_QRBolivia;User Id=yasta_dev;Password=YastaDev2026!;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  // Valor por defecto de los cuatro servicios externos. Cada uno lo puede pisar
  // con "Services:<Nombre>:UseFake".
  "UseFakeExternalServices": true,

  "DevAuth": {
    "Enabled": true,
    "ClientId": 1
  },

  "Services": {
    "Client": { "BaseAddress": "https://localhost:52140" },

    // Comercios ya esta desplegado: se consume de verdad, no el catalogo en
    // memoria. Poner en BaseAddress el host y puerto donde escucha el
    // microservicio; usar http:// si no tiene TLS (un certificado autofirmado
    // se acepta igual, no hace falta instalarlo).
    "Commerce": {
      "UseFake": false,
      "BaseAddress": "https://10.73.72.110:59537"
    },

    // QR ya esta desplegado: se consume de verdad contra su contrato oficial.
    // Poner en BaseAddress el host y puerto donde escucha el microservicio; si
    // todavia no esta arriba, volver UseFake a true y se usa FakeQrService.
    "Qr": {
      "UseFake": false,
      "BaseAddress": "https://10.73.72.110:52118"
    },

    "Currency": { "BaseAddress": "https://localhost:52146" }
  }
}

