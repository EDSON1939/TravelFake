{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Grpc": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\QRBolivia\\AccountsAndMovements\\logs\\dev-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "",
    "ServiceName": "accounts-movements-service-dev"
  },

  "Database": {
    "ConnectionString": "Server=localhost\\SQLEXPRESS;Database=DB_QRBolivia;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "UseFakeExternalServices": true,

  "DevAuth": {
    "Enabled": true,
    "ClientId": 1
  },

  "Services": {
    "Client":   { "BaseAddress": "https://localhost:52140" },
    "Merchant": { "BaseAddress": "https://localhost:52142" },
    "Qr":       { "BaseAddress": "https://localhost:52144" },
    "Currency": { "BaseAddress": "https://localhost:52146" }
  }
}

